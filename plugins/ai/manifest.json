{
  "id": "ai",
  "name": "AI 对话",
  "version": "0.1.0",
  "api_version": "^1",
  "trigger": "/ai",
  "description": "AI 对话助手：/ai 提示词 打开对话窗口（默认 DeepSeek，OpenAI 兼容流式；首次使用需在窗口内配置 API Key）",
  "permissions": [
    "secrets",
    "settings",
    "windows",
    "net:api.deepseek.com",
    "net:api.openai.com"
  ],
  "views": [
    {
      "id": "chat",
      "title": "LiteLauncher - AI 对话",
      "width": 720,
      "height": 560,
      "min_width": 520,
      "min_height": 420,
      "resizable": true,
      "decorated": false,
      "focusable": true,
      "position": "center",
      "on_existing": "focus"
    }
  ],
  "backend": {
    "kind": "native",
    "entry": [
      "ai.dll",
      "libai.so"
    ],
    "integrity": "sha256:34a8255c30b473e9ae2314ce47bbc1d6644c0bcd7cb0cf9316f9eb7c005a098f"
  }
}
