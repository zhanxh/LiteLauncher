{
  "id": "ai",
  "name": "AI 对话",
  "version": "0.1.0",
  "api_version": "^1",
  "trigger": "/ai",
  "description": "AI 对话助手：/ai 提示词 打开对话窗口（默认 DeepSeek，OpenAI 兼容流式；首次使用需在窗口内配置 API Key）",
  "permissions": [
    "secrets",
    "settings",
    "windows",
    "net:api.deepseek.com",
    "net:api.openai.com"
  ],
  "views": [
    {
      "id": "chat",
      "title": "LiteLauncher - AI 对话",
      "width": 720,
      "height": 560,
      "min_width": 520,
      "min_height": 420,
      "resizable": true,
      "decorated": false,
      "focusable": true,
      "position": "center",
      "on_existing": "focus"
    }
  ],
  "backend": {
    "kind": "native",
    "entry": [
      "ai.dll",
      "libai.so"
    ],
    "integrity": "sha256:1043dfb289b62f1b3b7967aad7abe565197e974f54da1537e0b387fa2c05c987"
  }
}
