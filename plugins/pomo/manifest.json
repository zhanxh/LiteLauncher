{
  "id": "pomo",
  "name": "番茄钟",
  "version": "0.1.0",
  "api_version": "^1",
  "trigger": "/pomo",
  "description": "番茄钟：/pomo start 25 写代码 开始计时（默认 25 分钟），到点发系统通知；/pomo 查看剩余时间；/pomo stop 停止。",
  "permissions": ["notifications", "settings"],
  "backend": {
    "kind": "llp",
    "entry": ["python3", "pomo.py"]
  },
  "command": {
    "icon": "🍅",
    "action_subcommands": ["start", "stop"],
    "hint": "回车开始 / 停止计时"
  }
}
