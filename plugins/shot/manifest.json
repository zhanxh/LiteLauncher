{
  "id": "shot",
  "name": "屏幕截图",
  "version": "0.5.0",
  "api_version": "^1",
  "trigger": "/shot",
  "description": "屏幕截图（flameshot 式流程）：先隐藏启动器，冻结整屏置顶、选区外虚化供框选；松手后可在冻结画面上即时作画（画笔/矩形/圆形/箭头/马赛克，支持配色与撤销），确认后选区原位钉图置顶（右键复制/关闭）；也可进标注层画箭头/马赛克/文字；/shot -d3 延时 3 秒。全局热键 Alt+Shift+S 直达区域框选，图片本体自动进剪贴板。",
  "permissions": [
    "screen",
    "clipboard:write",
    "notifications",
    "settings",
    "process",
    "windows",
    "shortcut:alt+shift+s"
  ],
  "hotkeys": [
    {
      "id": "capture",
      "default": "alt+shift+s",
      "label": "区域截图",
      "description": "按热键直接拖拽框选区域，图片进剪贴板并原位钉图",
      "scope": "main",
      "editable": true,
      "enabled": true
    }
  ],
  "views": [
    {
      "id": "select",
      "title": "LiteLauncher - 区域截图",
      "width": 800.0,
      "height": 600.0,
      "resizable": false,
      "decorated": false,
      "always_on_top": true,
      "skip_taskbar": true,
      "focusable": true,
      "shadow": false,
      "position": "fullscreen",
      "transparent": true,
      "on_existing": "replace"
    },
    {
      "id": "annotate",
      "title": "LiteLauncher - 截图标注",
      "width": 900.0,
      "height": 700.0,
      "min_width": 520.0,
      "min_height": 420.0,
      "resizable": true,
      "decorated": false,
      "always_on_top": true,
      "focusable": true,
      "position": "center",
      "on_existing": "replace"
    },
    {
      "id": "pin",
      "title": "LiteLauncher - 截图钉图",
      "width": 320.0,
      "height": 240.0,
      "resizable": false,
      "decorated": false,
      "always_on_top": true,
      "skip_taskbar": true,
      "focusable": true,
      "shadow": false,
      "transparent": true,
      "rounded": false,
      "position": "center",
      "unique_by": "pinId",
      "geometry_from_params": true,
      "on_existing": "replace"
    }
  ],
  "backend": {
    "kind": "none"
  },
  "command": {
    "icon": "📸",
    "action_subcommands": [],
    "hint": "回车区域框选，松手可作画（画笔/矩形/圆形/箭头/马赛克），确认后原位钉图（右键复制/关闭）；Alt+Shift+S 免开启动器框选；/hotkey 查全部全局热键"
  }
}
