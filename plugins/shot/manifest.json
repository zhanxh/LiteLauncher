{
  "id": "shot",
  "name": "屏幕截图",
  "version": "0.3.0",
  "api_version": "^1",
  "trigger": "/shot",
  "description": "屏幕截图：回车区域框选（推荐）、整屏截图，或框选后进标注层画箭头/马赛克/文字；/shot -d3 延时 3 秒。图片本体自动进剪贴板可直接粘贴。",
  "permissions": [
    "screen",
    "clipboard:write",
    "notifications",
    "settings",
    "process",
    "windows",
    "shortcut:alt+shift+s"
  ],
  "views": [
    {
      "id": "select",
      "title": "LiteLauncher - 区域截图",
      "width": 800.0,
      "height": 600.0,
      "resizable": false,
      "decorated": false,
      "always_on_top": true,
      "skip_taskbar": true,
      "focusable": true,
      "position": "fullscreen",
      "transparent": true,
      "on_existing": "replace"
    },
    {
      "id": "annotate",
      "title": "LiteLauncher - 截图标注",
      "width": 900.0,
      "height": 700.0,
      "min_width": 520.0,
      "min_height": 420.0,
      "resizable": true,
      "decorated": false,
      "always_on_top": true,
      "focusable": true,
      "position": "center",
      "on_existing": "replace"
    }
  ],
  "backend": {
    "kind": "none"
  },
  "command": {
    "icon": "📸",
    "action_subcommands": [],
    "hint": "回车区域框选；Alt+Shift+S 免开启动器整屏截图；/hotkey 查全部全局热键"
  }
}
