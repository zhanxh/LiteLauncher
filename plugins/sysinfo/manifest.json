{
  "id": "sysinfo",
  "name": "系统信息",
  "version": "0.2.0",
  "api_version": "^1",
  "trigger": "/sysinfo",
  "description": "系统信息查询：/sysinfo 列出内核/内存/进程内存/磁盘/开机时长；/sysinfo open 打开系统监视器。信息由插件在宿主进程内直接采集（Windows 走 Win32、Linux 读 /proc），无 Python 依赖。",
  "permissions": [
    "notifications",
    "process"
  ],
  "backend": {
    "kind": "native",
    "entry": [
      "sysinfo.dll",
      "libsysinfo.so"
    ],
    "integrity": "sha256:0a1185670e2dce459eda810d4688a4fb129bed24895e47d870e344dedfb8a47c"
  },
  "command": {
    "icon": "🖥️",
    "action_subcommands": [
      "open"
    ],
    "hint": "输入 open 回车打开系统监视器；或直接回车查看信息条目"
  }
}
