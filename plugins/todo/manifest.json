{
  "id": "todo",
  "name": "日程管理",
  "version": "0.1.0",
  "api_version": "^1",
  "trigger": "/cal",
  "permissions": ["db", "windows", "notifications", "settings", "events"],
  "views": [
    {
      "id": "calendar",
      "title": "LiteLauncher - 日程",
      "width": 960.0,
      "height": 720.0,
      "min_width": 720.0,
      "min_height": 560.0,
      "resizable": true,
      "decorated": true,
      "focusable": true,
      "position": "center",
      "on_existing": "focus"
    },
    {
      "id": "todoapp",
      "title": "LiteLauncher - 待办管理",
      "width": 580.0,
      "height": 680.0,
      "min_width": 480.0,
      "min_height": 520.0,
      "resizable": true,
      "decorated": true,
      "focusable": true,
      "position": "center",
      "on_existing": "focus"
    },
    {
      "id": "reminder",
      "title": "LiteLauncher 待办提醒",
      "width": 360.0,
      "height": 182.0,
      "min_width": 320.0,
      "min_height": 120.0,
      "max_height": 320.0,
      "auto_height": true,
      "resizable": false,
      "decorated": false,
      "always_on_top": true,
      "skip_taskbar": true,
      "focusable": false,
      "position": "bottom-right",
      "stacked": true,
      "unique_by": "id",
      "on_existing": "replace"
    },
    {
      "id": "detail",
      "title": "LiteLauncher - 日程详情",
      "width": 440.0,
      "height": 420.0,
      "min_width": 440.0,
      "min_height": 160.0,
      "max_height": 720.0,
      "auto_height": true,
      "resizable": false,
      "decorated": false,
      "focusable": true,
      "position": "center",
      "unique_by": "event",
      "on_existing": "focus"
    }
  ],
  "settings": [
    {
      "key": "default_duration_min",
      "label": "日程默认时长（分钟）",
      "kind": "number",
      "min": 5,
      "max": 1440,
      "default": 60
    }
  ]
}
