{
  "id": "todo",
  "name": "日程管理",
  "version": "0.1.1",
  "api_version": "^1",
  "trigger": "/cal",
  "permissions": [
    "db",
    "windows",
    "notifications",
    "settings",
    "events"
  ],
  "views": [
    {
      "id": "calendar",
      "title": "LiteLauncher - 日程",
      "width": 960,
      "height": 720,
      "min_width": 720,
      "min_height": 560,
      "resizable": true,
      "decorated": false,
      "focusable": true,
      "position": "center",
      "on_existing": "focus"
    },
    {
      "id": "todoapp",
      "title": "LiteLauncher - 待办管理",
      "width": 580,
      "height": 680,
      "min_width": 480,
      "min_height": 520,
      "resizable": true,
      "decorated": false,
      "focusable": true,
      "position": "center",
      "on_existing": "focus"
    },
    {
      "id": "reminder",
      "title": "LiteLauncher 待办提醒",
      "width": 360,
      "height": 182,
      "min_width": 320,
      "min_height": 120,
      "max_height": 320,
      "auto_height": true,
      "resizable": false,
      "decorated": false,
      "shadow": false,
      "always_on_top": true,
      "skip_taskbar": true,
      "focusable": false,
      "position": "bottom-right",
      "stacked": true,
      "unique_by": "id",
      "on_existing": "replace"
    },
    {
      "id": "detail",
      "title": "LiteLauncher - 日程详情",
      "width": 440,
      "height": 420,
      "min_width": 440,
      "min_height": 160,
      "max_height": 720,
      "auto_height": true,
      "resizable": false,
      "decorated": false,
      "shadow": false,
      "focusable": true,
      "position": "center",
      "unique_by": "event",
      "on_existing": "focus"
    }
  ],
  "settings": [
    {
      "key": "default_duration_min",
      "label": "日程默认时长（分钟）",
      "kind": "number",
      "min": 5,
      "max": 1440,
      "default": 60
    }
  ],
  "backend": {
    "kind": "native",
    "entry": [
      "todo.dll",
      "libtodo.so"
    ],
    "integrity": "sha256:adc93ed75e8ac372e45980fa58755574c46bed292cfbb613aed3a51d2ec01d2c"
  }
}
