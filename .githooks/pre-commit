#!/bin/sh
# LiteLauncher pre-commit 门禁：
#   1) 存在有效任务绑定（docs/plans + .agent/contexts）
#   2) 新增 plugins/<id>/ 或 src-tauri/crates/<crate>/ 时，必须同时新增 docs/design/ 设计文档
#   3) 本次提交必须更新 CHANGELOG.md（merge/rebase 场景自动跳过）
# 规则：docs/standards/basic/plan-workflow.md、design-workflow.md、coding-conventions.md
# 启用：npm run hooks:install        临时跳过：GATE_SKIP=1 git commit ...

if ! command -v node >/dev/null 2>&1; then
  echo "[gate] 未找到 node，跳过门禁（安装 Node.js 后自动生效）"
  exit 0
fi

exec node tools/agent/gate-check.mjs --check-active --check-design --check-changelog
