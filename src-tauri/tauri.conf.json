{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LiteLauncher",
  "version": "0.2.0",
  "identifier": "com.litelauncher.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LiteLauncher",
        "url": "index.html?transparent=1",
        "width": 680,
        "height": 70,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "center": true,
        "focus": true,
        "visible": false,
        "resizable": false,
        "skipTaskbar": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "category": "Utility",
    "license": "MIT",
    "shortDescription": "桌面快捷启动器：插件化的搜索、截图、剪贴板与工具集合",
    "longDescription": "LiteLauncher 是无边框常驻桌面的启动器。内置待办/应用/笔记/AI 插件，外部插件（LLP/1）拷入目录即装，支持 Python 等任意语言运行时。",
    "createUpdaterArtifacts": true,
    "resources": {
      "../release/plugins": "plugins"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": true
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/zhanxiaohai/LiteLauncher/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDA3NjJFRjg1QjRGNTEwMkQKUldRdEVQVzBoZTlpQnlHaTduRXlsQ2hVeHM5R3ErMC9qd0FxYk9HWFRwRjRMbUdJR2JYekI0NkYK"
    }
  }
}
