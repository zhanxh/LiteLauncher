{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main launcher window and dynamically created note editor windows",
  "windows": ["main", "editor-*", "reminder-*", "todo-manager", "app-settings"],
  "permissions": [
    "core:default",
    "opener:default",
    "global-shortcut:default",
    "notification:default",
    "core:window:allow-close",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-set-focus"
  ]
}
