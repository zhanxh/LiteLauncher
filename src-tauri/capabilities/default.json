{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main launcher window and dynamically created plugin view windows (label = <pluginId>-<viewId>)",
  "windows": ["main", "editor-*", "reminder-*", "todo-manager", "app-settings", "welcome", "todo-*", "notes-*", "apps-*", "ai-*", "pick-*", "shot-*", "clip-*", "pomo-*", "echo-*", "time-*"],
  "permissions": [
    "core:default",
    "opener:default",
    "global-shortcut:default",
    "notification:default",
    "updater:default",
    "process:allow-restart",
    "process:allow-exit",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:window:allow-start-dragging",
    "core:window:allow-outer-position",
    "core:window:allow-outer-size",
    "core:window:allow-set-size",
    "core:window:allow-set-position"
  ]
}
