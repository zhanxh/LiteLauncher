{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2020", "DOM"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "preserve",
    "jsxImportSource": "solid-js",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    /* 插件包解析（与 vite.config.ts 别名一致，paths 相对 tsconfig 所在目录） */
    "paths": {
      "@ll/sdk": ["./plugins/sdk/src/index.ts"],
      "@ll/ui": ["./plugins/ui/src/index.ts"],
      "@ll/plugin-*": ["./plugins/*/fe/src/index.ts"]
    }
  },
  "include": ["src", "plugins/sdk/src", "plugins/ui/src", "plugins/*/fe/src"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
